Time Complexity: O(N)
Space Complexity: O(1)

class Solution {
    public ListNode removeNthFromEnd(ListNode head, int n) {

        int length = 0;
        ListNode curr = head;

        while(curr != null){
            length++;
            curr = curr.next;
        }

        if(n == length){
            return head.next;
        }
        
        int removeFromFront = length - n - 1;
        length = 0;
        curr = head;

        while(length != removeFromFront){
            curr = curr.next;
            length++;
        }

        if(curr.next.next == null){
            curr.next = null;
            return head;
        }
        else{
            curr.next = curr.next.next;
        }
        return head;
    }
}
