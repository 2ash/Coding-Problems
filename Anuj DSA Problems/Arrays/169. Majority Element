Time Complexity: O(N)
Space Complexity: O(1)

class Solution {
    public int majorityElement(int[] arr) {
        int n = arr.length;
        int count = 1;
        int ele = arr[0];

        for(int i = 1; i < n; i++){
            if(arr[i] == ele){
                count++;
            }
            else{
                count--;
                if(count == 0){
                    count = 1;
                    ele = arr[i];
                }
            }
        }
        return ele; 
    }
}
